{
  "name": "amazon-ph-simulators",
  "productName": "Project Amazon PH Academy SimGrid",
  "version": "1.2.4",
  "description": "Desktop wrapper for the Project Amazon PH Academy PPC simulators.",
  "homepage": "https://projectamazonph.github.io/amazon-ph-simulators/",
  "author": "Project Amazon PH Academy",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:win:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.projectamazonph.simgrid",
    "productName": "Project Amazon PH Academy SimGrid",
    "artifactName": "SimGrid-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "*.html",
      "favicon.ico",
      "assets/**/*",
      "learn/**/*",
      "coach-decks/**/*",
      "downloads/**/*",
      "desktop/main.cjs",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "projectamazonph",
      "repo": "amazon-ph-simulators",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimGrid",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": "Project Amazon PH Academy",
      "license": "build/installer-info.txt"
    }
  }
}
