// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note: In Prisma 7 the URL moved to prisma.config.ts.
// The datasource url is configured there, not here.

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
}

enum SimulatorAccess {
  NONE
  SELLER_CENTRAL
  PPC
  FULL
}

// ── Models ─────────────────────────────────────────────────

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role    @default(STUDENT)
  avatarUrl String?
  bio       String?

  // Email verification
  emailVerificationToken String?            @unique
  emailVerifiedAt        DateTime?
  verificationStatus     VerificationStatus @default(UNVERIFIED)

  // Subscription
  subscriptionTier             SubscriptionTier @default(FREE)
  subscriptionEndsAt           DateTime?
  paymongoCustomerId           String?          @unique
  paymongoDefaultPaymentMethod String?

  // AMPH course access
  simulatorAccess   SimulatorAccess @default(NONE)
  // Deprecated (Proposal 8): denormalized copy of Enrollment rows,
  // no longer read or written by application code — Enrollment is
  // the sole source of truth for course access. Column kept for now
  // (multi-step removal); do not add new reads/writes.
  enrolledCourseIds String[]        @default([])

  // XP (experience points)
  totalXp Int @default(0)

  // Security
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  // Two-factor authentication (audit hardening — admin 2FA)
  // twoFactorSecret is intentionally never exposed on the domain User
  // entity (same treatment as `password` — accessed only via narrow
  // UserRepository methods), so it can't ride along on every User read.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  sessions               Session[]
  enrollments            Enrollment[]
  orders                 Order[]
  auditLogs              AuditLog[]
  ppcCampaigns           PpcCampaign[]
  certificates           Certificate[]
  emailVerifications     EmailVerification[]
  passwordResets         PasswordReset[]
  liveClassRegistrations LiveClassRegistration[]

  @@index([email])
  @@index([paymongoCustomerId])
  @@map("users")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime

  // Rotation
  rotatedFrom String? @unique

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Course {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  tagline     String
  description String

  // Pricing
  priceMinor    Int
  currency      String       @default("PHP")
  pricingTierId String?
  pricingTier   PricingTier? @relation(fields: [pricingTierId], references: [id])

  // Content
  curriculum   Json // { sections: [{ title, lessons: [{ title, type, content }] }] }
  coverImage   String?
  previewVideo String?

  // Meta
  isPublished        Boolean @default(false)
  isFeatured         Boolean @default(false)
  displayOrder       Int     @default(0)
  courseTier         String  @default("STARTER")
  previewLessonCount Int     @default(1)

  // PayMongo
  paymongoPriceId String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments  Enrollment[]
  orders       Order[]
  certificates Certificate[]
  liveClasses  LiveClass[]
  modules      Module[]

  @@map("courses")
}

// ── STORY-011: Pricing Tiers ─────────────────────────────

model PricingTier {
  id         String @id @default(cuid())
  slug       String @unique // "foundations", "mastery", "ultimate", "all-access"
  name       String
  priceMinor Int
  currency   String @default("PHP")

  // Lifecycle: DRAFT (admin only) -> ACTIVE (visible on /pricing) -> ARCHIVED.
  // Follows the Course.status / LiveClass.status convention, not the
  // DiscountCode.archivedAt / SimulatorScenario.archivedAt convention.
  status String @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED

  displayOrder Int @default(0)

  // Early-bird pricing: time-windowed discount shown on /pricing.
  // STORY-015.
  earlyBirdPriceMinor Int?
  earlyBirdEndsAt     DateTime?

  // Relations
  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayOrder])
  @@map("pricing_tiers")
}

// ── STORY-048b/048c / P0-2 follow-up: Modules + Lessons ──

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title        String
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title        String
  type         String // VIDEO | TEXT | QUIZ
  content      Json
  plannedMinutes Int @default(0) // planned learner time for every lesson type
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

// ── STORY-050b: Simulator scenarios ─────────────────────

model SimulatorScenario {
  id          String @id @default(cuid())
  simulatorId String // bid-elevator | str-triage | campaign-builder | listing-audit | keyword-research
  name        String
  description String

  inputSchema  Json
  outputSchema Json

  difficulty       String // beginner | intermediate | advanced
  estimatedMinutes Int

  // STORY-085: publishing + versioning. scenarioKey groups every version of
  // "the same" scenario; status is the lifecycle signal the app reasons
  // about (draft | published | archived). At most one row per scenarioKey
  // should be "published" at a time — enforced in the use-case layer via
  // PrismaSimulatorScenarioRepository.publish()'s transaction, not a DB
  // constraint (solo-admin, low-traffic app; not worth the added rigor).
  scenarioKey String
  version     Int    @default(1)
  status      String @default("published") // draft | published | archived

  // Soft-delete marker, kept for the existing index/audit trail. `status`
  // is the primary lifecycle signal now; this is set alongside status
  // transitioning to "archived" but not read on its own.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([simulatorId])
  @@index([archivedAt])
  @@index([scenarioKey])
  @@index([status])
  @@map("simulator_scenarios")
}

// ── STORY-050c: Live classes ────────────────────────────

model LiveClass {
  id              String                  @id @default(cuid())
  courseId        String
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  instructorId    String
  meetingUrl      String
  status          String                  @default("scheduled") // scheduled | cancelled | completed
  recordingUrl    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  registrations   LiveClassRegistration[]

  @@index([courseId])
  @@index([status])
  @@index([scheduledAt])
  @@map("live_classes")
}

model LiveClassRegistration {
  id                 String    @id @default(cuid())
  userId             String
  liveClassId        String
  liveClass          LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String    @default("registered") // registered | cancelled | attended | no_show
  registeredAt       DateTime  @default(now())
  cancelledAt        DateTime?
  watchedRecordingAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, liveClassId])
  @@index([userId])
  @@index([liveClassId])
  @@index([status])
  @@map("live_class_registrations")
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status String @default("active") // active | cancelled | refunded | expired
  source String @default("direct") // direct | affiliate | simulator_trial | subscription

  // Progress
  completedLessonIds String[] @default([])
  lastLessonId       String?
  progressPercent    Int      @default(0)

  // Coupon
  couponCode     String?
  couponDiscount Int?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Domain state machine: DRAFT | PENDING | PAID | FAILED | EXPIRED | REFUNDED
  status String @default("DRAFT")

  // Money (always minor units)
  subtotalMinor    Int
  discountMinor    Int    @default(0)
  platformFeeMinor Int    @default(0)
  totalMinor       Int
  currency         String @default("PHP")

  // PayMongo
  paymongoPaymentId   String?   @unique
  paymongoCheckoutUrl String?
  paymongoStatus      String? // pending | paid | failed | expired | refunded | partially_refunded
  paymongoPaidAt      DateTime?

  // Manual override (e.g. affiliate free enrollment)
  manuallySetBy     String?
  manuallySetReason String?
  manuallySetAt     DateTime?

  // Refund
  refundReason      String?
  refundRequestedAt DateTime?
  refundProcessedAt DateTime?
  refundAmountMinor Int?

  // Receipt
  receiptNumber String? @unique

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([paymongoPaymentId])
  @@index([status])
  // Proposal 7: composite indexes for real query patterns —
  // PrismaOrderRepository.listAll({status}) filters by status and
  // sorts by createdAt desc; listRefundRequests() always filters
  // refundRequestedAt IS NOT NULL and sorts by [refundRequestedAt
  // desc, id desc]; findPaidForUserAndCourse() filters all three
  // columns together. The single-column indexes above can't satisfy
  // the filter+sort or multi-column-equality parts of these queries
  // without an extra sort/heap-filter step.
  @@index([status, createdAt])
  @@index([refundRequestedAt, id])
  @@index([userId, courseId, status])
  @@map("orders")
}

model PpcCampaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  budgetMinor Int
  currency    String @default("PHP")

  // Simulation state
  dailySpendMinor Int @default(0)
  impressions     Int @default(0)
  clicks          Int @default(0)
  conversions     Int @default(0)
  avgCpcMinor     Int @default(0)

  // Daily snapshot roll-up
  dailySnapshots Json @default("[]")

  status String @default("active") // active | paused | exhausted | ended

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ppc_campaigns")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Actor tracking
  actorType String  @default("user") // user | system | admin
  actorId   String?
  ipAddress String?

  // What happened
  action     String // e.g. "order.created", "user.login_failed"
  resource   String // e.g. "order", "user"
  resourceId String?

  // Details
  payload Json @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  // Proposal 7: PrismaAuditLog.list() paginates with a keyset cursor
  // that compares (createdAt, id) together and sorts by
  // [createdAt desc, id desc] — a single-column createdAt index can't
  // fully satisfy either the tie-break comparison or the sort.
  @@index([createdAt, id])
  @@map("audit_logs")
}

// ── Audit hardening: webhook event log ───────────────────────

// Persists every inbound webhook payload independent of business-entity
// state (Order, etc.), so a webhook that fails signature verification,
// arrives before its order exists, or needs replaying leaves a durable
// trace. rawPayload is String (not Json) so an unparseable body still
// persists instead of being rejected by the column type.
model WebhookEvent {
  id              String  @id @default(cuid())
  provider        String // e.g. "paymongo"
  eventType       String // e.g. "checkout_session.completed", "invalid_signature", "invalid_json"
  providerEventId String? // e.g. PayMongo checkout session id, when known
  signatureValid  Boolean
  rawPayload      String

  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([providerEventId])
  @@index([createdAt])
  @@map("webhook_events")
}

model EmailLog {
  id        String  @id @default(cuid())
  to        String
  from      String
  subject   String
  template  String
  status    String  @default("queued") // queued | sent | bounced | complained
  messageId String? @unique

  // Resend API
  resendId String? @unique

  // Audit
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([to])
  @@index([status])
  @@map("email_logs")
}

// ── STORY-024: Discount Codes ────────────────────────────────

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique // uppercase, e.g. "SAVE20"
  type       String // PERCENTAGE | FIXED
  value      Int // percentage (1-100) or minor units (e.g. 10000 = PHP 100.00)
  maxUses    Int? // null = unlimited
  usedCount  Int       @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  courseIds  String[]  @default([]) // empty = all courses; non-empty = applies only to these

  // STORY-050d: soft-delete. Null = active. Archived codes are hidden from
  // listAll()/findById() but still findByCode()-able (matches InMemoryDiscountCodeRepository).
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@index([archivedAt])
  @@map("discount_codes")
}

// ── STORY-028: XP Events ────────────────────────────────

model XPEvent {
  id     String  @id @default(cuid())
  userId String
  amount Int
  reason String // lesson_completed | course_completed | quiz_passed | streak_bonus
  refId    String? // lessonId, courseId, quizAttemptId, etc.
  awardKey String  @unique // stable business-event idempotency key

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("xp_events")
}

// ── STORY-027: Progress Events ────────────────────────────────

model ProgressEvent {
  id       String  @id @default(cuid())
  userId   String
  courseId String
  lessonId String?
  type     String // lesson_completed | course_started | course_completed
  metadata Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
  // Proposal 7: PrismaProgressEventRepository.findByUserId/findByCourseId
  // each filter on one column and sort by createdAt desc.
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@map("progress_events")
}

// ── STORY-029: User Streaks ────────────────────────────────────────────

model UserStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(1)
  longestStreak Int      @default(1)
  lastVisitDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_streaks")
}

// ── STORY-031: Quizzes ─────────────────────────────────────────────────────

model Quiz {
  id           String         @id @default(cuid())
  courseId     String
  title        String
  passingScore Int            @default(70)
  questions    QuizQuestion[]
  createdAt    DateTime       @default(now())

  @@map("quizzes")
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  explanation  String       @default("")
  options      QuizOption[]
  order        Int          @default(0)

  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)

  @@map("quiz_options")
}

model QuizAttempt {
  id          String              @id @default(cuid())
  userId      String
  quizId      String
  status      String              @default("in_progress")
  score       Int?
  passed      Boolean?
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  answers     QuizAttemptAnswer[]

  // Proposal 7: widened from [userId, quizId] — findByUserAndQuiz() and
  // findLatestByUserAndQuiz() both filter on {userId, quizId} and sort
  // by startedAt desc; the 2-column index couldn't satisfy the sort
  // without an extra step.
  @@index([userId, quizId, startedAt])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  selectedOptionId String

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

// ── Badges ──────────────────────────────────────────────────────────────────

model Badge {
  slug        String       @id // e.g. "first-quiz-pass"
  name        String
  description String
  iconName    String // Phosphor icon name
  xpReward    Int          @default(0)
  archived    Boolean      @default(false) // STORY-050e: admin can hide archived badges
  awards      BadgeAward[]

  @@map("badges")
}

model BadgeAward {
  id        String   @id @default(cuid())
  userId    String
  badgeSlug String
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeSlug], references: [slug])

  @@unique([userId, badgeSlug])
  @@index([userId])
  @@map("badge_awards")
}

// ── Certificates ───────────────────────────────────────────────────────────

model Certificate {
  id               String    @id // ULID
  userId           String
  courseId         String
  verificationHash String    @unique
  issuedAt         DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  status           String    @default("active") // active | revoked

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId]) // one cert per (user, course)
  @@index([userId])
  @@index([verificationHash])
  @@map("certificates")
}

// ── Email verification (STORY-007) ─────────────────────────────────────────

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verifications")
}

// ── Password reset (STORY-008) ───────────────────────────────────

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ── Live class reminder log (P0-7 follow-up) ───────────────────────

model SentReminder {
  id          String   @id @default(cuid())
  liveClassId String
  userId      String
  sentAt      DateTime @default(now())

  // Unique on the (liveClassId, userId) pair so the database itself
  // enforces "you can't send the same reminder twice". The use case
  // treats a unique violation as success (the row already exists,
  // so the email was already sent on a prior cron run).
  @@unique([liveClassId, userId])
  @@index([liveClassId])
  @@map("sent_reminders")
}

// ── STORY-064: Simulator Attempts ─────────────────────────────────

model SimulatorAttempt {
  id              String              @id
  attemptId       String              @unique // human-readable, e.g. "ATT-A1B2C3"
  userId          String
  simulatorId     String
  scenarioId      String
  scenarioVersion Int                 @default(1)
  difficulty      String // beginner | intermediate | advanced
  mode            String              @default("practice")
  status          String              @default("in_progress") // in_progress | submitted | graded | expired
  seed            String?
  score           Int?
  scoreDimensions Json?
  startedAt       DateTime            @default(now())
  submittedAt     DateTime?
  gradedAt        DateTime?
  decisions       SimulatorDecision[]

  @@index([userId])
  @@index([simulatorId])
  @@index([status])
  @@index([userId, simulatorId, status])
  @@map("simulator_attempts")
}

model SimulatorDecision {
  id           String           @id
  attemptId    String
  attempt      SimulatorAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  revision     Int              @default(1)
  decisionData Json
  submittedAt  DateTime         @default(now())

  @@unique([attemptId, revision])
  @@map("simulator_decisions")
}

// ── STORY-065: Scoring Engine ───────────────────────────────────────────

model ScorePolicy {
  id              String   @id @default(cuid())
  simulatorId     String
  difficulty      String
  mode            String
  /**
   * JSON: Record<string, { weight: number; passingThreshold: number }>
   */
  dimensionConfig Json
  passingScore    Int      @default(70)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([simulatorId, difficulty, mode])
  @@index([simulatorId])
  @@map("score_policies")
}

// ── STORY-086: Simulator grader - instructor calibration ranges ────────
//
// One calibration row per (simulatorId, scenarioKey). Bands clamp the
// per-dimension raw score into a strict subset of [0, 100] before
// getOverallScore runs. See SimulatorScenarioCalibration (domain) for
// the entity-level invariants; the schema only persists JSON.
model SimulatorScenarioCalibration {
  id             String   @id @default(cuid())
  simulatorId    String
  scenarioKey    String
  dimensionBands Json // Record<dimensionKey, { minScore, maxScore }>
  instructorId   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([simulatorId, scenarioKey])
  @@index([scenarioKey])
  @@index([instructorId])
  @@map("simulator_scenario_calibrations")
}

// ── STORY-063: Email Templates ──────────────────────────────────────────────

model EmailTemplate {
  id          String   @id @default(cuid())
  type        String   @unique // EmailTemplateType discriminator (one row per type)
  subject     String
  headline    String
  introBody   String
  ctaLabel    String
  updatedAt   DateTime @updatedAt
  updatedById String

  @@map("email_templates")
}

// ── STORY-066: Feedback Composer ─────────────────────────────────────────────

model AttemptFeedback {
  id                String   @id @default(cuid())
  attemptId         String   @unique
  userId            String
  simulatorId       String
  scenarioId        String
  difficulty        String
  mode              String
  overallScore      Int
  passed            Boolean
  overallComment    String
  remediationLinks  Json
  dimensionFeedback Json
  completedAt       DateTime @default(now())

  @@index([userId])
  @@map("attempt_feedbacks")
}

// ── STORY-098: Download Center ───────────────────────────────────────────────

model Resource {
  id            String    @id @default(cuid())
  title         String
  description   String
  category      String // guide | template | automation_tool | cheat_sheet | handout
  fileType      String // pdf | xlsx | gsheet | docx | zip | link
  fileUrl       String
  fileKey       String? // storage key if uploaded via IFileStorage (STORY-098.5); null for static assets/external links
  accessTier    String    @default("PREVIEW") // STARTER | PRO | PREVIEW
  isPublished   Boolean   @default(true)
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Audit fields added in review. Bare String actor ids, no @relation —
  // same treatment as EmailTemplate.updatedById, the only existing
  // precedent in this schema for a "who did this" column; there's no
  // FK-relation precedent to follow instead. Nullable since rows
  // created before this migration have neither.
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  @@index([category])
  @@index([isPublished])
  @@index([accessTier])
  @@map("resources")
}


// =============================================================================
// P4 LMS Models (PR-A)
// =============================================================================

// --- P0: Payments & Invoicing ---

model Payment {
  id              String    @id @default(cuid())
  orderId         String
  amount          Int       // Stored as cents (PHP)
  currency        String    @default("PHP")
  paymentMethod   String    // gcash, maya, card, bank_transfer
  transactionId   String?   // External payment provider transaction ID
  status          String    @default("pending") // pending, completed, failed, refunded
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id              String    @id @default(cuid())
  orderId         String    @unique
  userId          String
  amount          Int       // Stored as cents (PHP)
  taxAmount       Int       @default(0)
  totalAmount     Int       // amount + taxAmount
  status          String    @default("draft") // draft, sent, paid, cancelled, void
  invoiceNumber   String    @unique
  dueDate         DateTime?
  paidAt          DateTime?
  birFormType     String?   // For Philippine BIR compliance
  birReference     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("invoices")
}

// --- P1: Learning Management ---

model Prerequisite {
  id              String    @id @default(cuid())
  courseId        String
  requiredCourseId String
  // A prerequisite can be: complete course, pass quiz, achieve badge
  type            String    @default("course_completion") // course_completion, quiz_pass, badge_earned
  minimumScore    Int?      // For quiz_pass type
  createdAt       DateTime  @default(now())

  @@unique([courseId, requiredCourseId, type])
  @@index([courseId])
  @@index([requiredCourseId])
  @@map("prerequisites")
}

model Assignment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  moduleId        String?
  lessonId        String?
  assignedById    String
  assignedAt      DateTime  @default(now())
  dueAt           DateTime?
  status          String    @default("assigned") // assigned, in_progress, submitted, graded, overdue
  submissionUrl   String?
  feedback        String?
  grade           Int?
  maxGrade        Int       @default(100)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("assignments")
}

// Note: Resource model already exists above

model OAuthAccount {
  id              String    @id @default(cuid())
  userId          String
  provider        String    // google, facebook, github, etc.
  providerAccountId String
  accessToken     String?
  refreshToken    String?
  expiresAt       DateTime?
  tokenType       String?
  scope           String?
  sessionState    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Setting {
  id              String    @id @default(cuid())
  key             String    @unique
  value           Json?
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([key])
  @@map("settings")
}

// Note: EmailTemplate model already exists

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  severity        String    @default("info") // info, warning, critical
  isActive        Boolean   @default(true)
  startAt         DateTime?
  endAt           DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
  @@map("announcements")
}

model Leaderboard {
  id              String    @id @default(cuid())
  name            String
  description     String?
  type            String    @default("xp") // xp, completion, quiz_score
  timeframe       String    @default("all_time") // all_time, weekly, monthly
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([type])
  @@map("leaderboards")
}

model LeaderboardEntry {
  id              String    @id @default(cuid())
  leaderboardId   String
  userId          String
  rank            Int
  score           Int
  metadata        Json?
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime  @default(now())

  @@unique([leaderboardId, userId, periodStart])
  @@index([leaderboardId])
  @@index([userId])
  @@index([rank])
  @@map("leaderboard_entries")
}

model DropOff {
  id              String    @id @default(cuid())
  userId          String
  courseId        String?
  moduleId        String?
  lessonId        String?
  droppedAt       DateTime  @default(now())
  resumedAt       DateTime?
  reason          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([droppedAt])
  @@map("drop_offs")
}

model QuizBank {
  id              String    @id @default(cuid())
  question        String
  options         Json      // Array of option objects
  correctAnswer   Json      // Array of correct option indices or IDs
  explanation     String?
  difficulty      String    @default("medium") // easy, medium, hard
  category        String?
  tags            String[]  @default([])
  isPublished     Boolean   @default(false)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([difficulty])
  @@map("quiz_bank")
}

model Affiliate {
  id              String    @id @default(cuid())
  userId          String?   // Optional: if affiliate is a registered user
  code            String    @unique
  name            String
  email           String?
  commissionRate  Float     @default(0.1) // 10% default
  payoutMethod    String?   // gcash, paypal, bank
  payoutDetails   Json?     // Bank account, PayPal email, etc.
  totalEarnings   Int       @default(0) // Stored as cents
  paidEarnings    Int       @default(0)
  status          String    @default("active") // active, suspended, terminated
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([status])
  @@map("affiliates")
}

model AffiliateConversion {
  id              String    @id @default(cuid())
  affiliateId     String
  userId          String
  orderId         String?
  amount          Int       // Conversion amount in cents
  commission      Int       // Commission earned in cents
  status          String    @default("pending") // pending, paid, cancelled
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([affiliateId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("affiliate_conversions")
}

model SkillMap {
  id              String    @id @default(cuid())
  name            String
  description     String?
  skills          Json      // Hierarchical skill structure
  version         Int       @default(1)
  isPublished     Boolean   @default(false)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
  @@map("skill_maps")
}

model UserSkill {
  id              String    @id @default(cuid())
  userId          String
  skillMapId      String
  skillId         String    // Reference to skill in the skill map
  proficiency     Int       @default(0) // 0-100
  lastAssessedAt  DateTime?
  evidenceUrl     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, skillMapId, skillId])
  @@index([userId])
  @@index([skillMapId])
  @@map("user_skills")
}

// --- P1-08: Maintenance Mode ---

// This is implemented via environment variable, not a database model
// The Maintenance model tracks maintenance windows and messages

model ListingAuditRule {
  id                   String    @id @default(cuid())
  ruleId               String
  dimension            String
  severity             String
  applicableCategories String[]  @default([])
  conditions           Json
  action               Json
  priority             Int       @default(0)
  isActive             Boolean   @default(true)
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([ruleId, dimension, severity, priority])
  @@index([ruleId])
  @@index([dimension])
  @@index([severity])
  @@index([isActive])
  @@index([priority])
  @@map("listing_audit_rules")
}

model Maintenance {
  id              String    @id @default(cuid())
  isActive        Boolean   @default(false)
  message         String?
  startAt         DateTime?
  endAt           DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@map("maintenance")
}
