# Required
DATABASE_URL="postgresql://user:password@localhost:5432/amph_dev"

# JWT
JWT_SECRET="generate-with-pnpm-gen-secret"

# PayMongo
PAYMONGO_SECRET="sk_test_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."  # Webhook signing secret from Resend dashboard
EMAIL_FROM="Project Amazon PH Academy <noreply@projectamazonph.online>"

# Sentry (optional in dev)
SENTRY_DSN=""

# Vercel Blob. Powers admin file uploads for the download center
# (/admin/resources). Local development can use LocalFileStorage when this is
# empty. Production fails closed because Vercel's serverless filesystem is not
# durable or writable for this use. Provision a Blob store for production; see
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Email verification
EMAIL_VERIFICATION_SECRET="generate-with-pnpm-gen-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database pool (optional, defaults to 5)
# DB_POOL_MAX=5

# P1-08 (P4 PR-A): maintenance mode / kill switch.
# MAINTENANCE_MODE: when "true", every non-admin request is rewritten
#   to /maintenance with a 503 status. No DB read, no bypass — this is
#   the emergency kill switch for an incident where the DB itself is
#   unreachable. Leave unset or "false" in normal operation.
# MAINTENANCE_BYPASS_TOKEN: when set, the proxy honours a matching
#   `amph_maintenance_bypass` cookie and lets the request through
#   even when MAINTENANCE_MODE is on. Use this so an admin can keep
#   working during an incident without having to disable the kill
#   switch. Generate a long random string (e.g. `openssl rand -hex 32`).
MAINTENANCE_MODE="false"
MAINTENANCE_BYPASS_TOKEN=""
