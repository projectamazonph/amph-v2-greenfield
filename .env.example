# Required
DATABASE_URL="postgresql://user:password@localhost:5432/amph_dev"

# JWT
JWT_SECRET="generate-with-pnpm-gen-secret"

# PayMongo
PAYMONGO_SECRET="sk_test_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."  # Webhook signing secret from Resend dashboard
EMAIL_FROM="Project Amazon PH Academy <noreply@projectamazonph.online>"

# Sentry (optional in dev)
SENTRY_DSN=""

# Vercel Blob. Powers admin file uploads for the download center
# (/admin/resources). Local development can use LocalFileStorage when this is
# empty. Production fails closed because Vercel's serverless filesystem is not
# durable or writable for this use. Provision a Blob store for production; see
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Email verification
EMAIL_VERIFICATION_SECRET="generate-with-pnpm-gen-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database pool (optional, defaults to 5)
# DB_POOL_MAX=5
