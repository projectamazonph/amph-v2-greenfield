# Required
DATABASE_URL="postgresql://user:password@localhost:5432/amph_dev"

# JWT
JWT_SECRET="generate-with-pnpm-gen-secret"

# PayMongo
PAYMONGO_SECRET="sk_test_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."  # Webhook signing secret from Resend dashboard
EMAIL_FROM="Project Amazon PH Academy <noreply@projectamazonph.online>"

# Sentry (optional in dev)
SENTRY_DSN=""

# Vercel Blob (optional). Powers admin file uploads for the download center
# (/admin/resources). Without it, uploads fall back to LocalFileStorage, which
# writes to public/uploads/ on local disk — fine for `pnpm dev`, but NOT viable
# in production on Vercel's read-only serverless filesystem. Provision a Blob
# store on the Vercel project to get a real token; see
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Email verification
EMAIL_VERIFICATION_SECRET="generate-with-pnpm-gen-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database pool (optional, defaults to 5)
# DB_POOL_MAX=5
